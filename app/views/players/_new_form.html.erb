<%= turbo_frame_tag "new_player" do %>
  <div class="card">
    <% player ||= Player.new %>
    <%= form_with model: player, url: players_path, local: true, html: { multipart: true, class: "h-100" } do |form| %>
      <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
        <div class="text-center">
          <%= form.file_field :photo, class: "form-control form-control-sm mb-2", accept: "image/*" %>
          <small class="text-muted">Upload a photo</small>
        </div>
      </div>
      <div class="card-body">
        <% if form.object.errors.any? %>
          <div class="alert alert-danger alert-sm">
            <% form.object.errors.full_messages.each do |message| %>
              <small><%= message %></small><br>
            <% end %>
          </div>
        <% end %>

        <div class="mb-3">
          <%= form.text_field :name, class: "form-control", placeholder: "Player name", required: true %>
        </div>

        <div class="mb-3">
          <%= form.date_field :birthdate, class: "form-control", required: true %>
        </div>

        <div class="d-flex justify-content-between">
          <%= form.submit "Create Player", class: "btn btn-primary btn-sm" %>
          <%= link_to "Cancel", players_path, 
              data: { turbo_method: :get, turbo_stream: true }, 
              class: "btn btn-outline-secondary btn-sm" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>