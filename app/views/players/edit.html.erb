<h1>Edit Player</h1>

<div class="row">
  <div class="col-md-6 mx-auto">
    <%= form_with model: @player, local: true, html: { multipart: true, class: "card" } do |form| %>
      <div class="card-body">
        <% if @player.errors.any? %>
          <div class="alert alert-danger">
            <h4><%= pluralize(@player.errors.count, "error") %> prohibited this player from being saved:</h4>
            <ul class="mb-0">
              <% @player.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="mb-3">
          <%= form.label :name, class: "form-label" %>
          <%= form.text_field :name, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :birthdate, class: "form-label" %>
          <%= form.date_field :birthdate, class: "form-control" %>
        </div>

        <div class="mb-3">
          <%= form.label :photo, class: "form-label" %>
          <%= form.file_field :photo, class: "form-control", accept: "image/*" %>
          <% if @player.photo.attached? %>
            <div class="mt-2">
              <small class="text-muted">Current photo:</small><br>
              <%= image_tag @player.photo, class: "img-thumbnail", style: "max-width: 150px;" %>
            </div>
          <% end %>
        </div>

        <div class="d-flex justify-content-between">
          <%= form.submit "Update Player", class: "btn btn-primary" %>
          <div>
            <%= link_to "Show", @player, class: "btn btn-outline-info" %>
            <%= link_to "Cancel", players_path, class: "btn btn-outline-secondary" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
